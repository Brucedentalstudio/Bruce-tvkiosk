# Cấu hình máy chạy Smilelog: Màn TV (tv) hoặc Danh sách ca + Kho việc (full).
# install.sh chép file này sang /etc/smilelog-tv.conf nếu chưa có.
# Sửa /etc/smilelog-tv.conf xong thì chạy lại: sudo ./install.sh

# Chế độ chạy. Đổi nhanh bằng lệnh (lưu vào file này, giữ sau khi khởi động lại): sudo smilelog-tv mode tv|full
#   tv   : chỉ chiếu Màn TV sản xuất, ngoài giờ làm chuyển sang màn chờ (nếu đặt giờ làm) (TV treo xưởng)
#   full : màn chính, mặc định. Mở Kho việc (APP_URL), bấm thao tác được.
#          Không có màn chờ ngoài giờ. Mở màn khác ngoài APP_PATHS quá 2 phút thì quay về APP_URL.
MODE="full"

# Đổi chế độ ngay trên TV, không cần SSH:
#   - Phím tắt (cắm bàn phím USB hoặc bàn phím không dây): Ctrl+Alt+M đổi chế độ,
#     Ctrl+Alt+R mở lại trình duyệt.
#   - Nút nổi ⇄ ở góc dưới bên trái: bấm để mở bảng, bấm "Chuyển sang ..." để xác nhận.
# Đặt "no" để ẩn nút nổi (phím tắt vẫn dùng được). Đổi xong chạy lại: sudo ./install.sh
SHOW_SWITCH_BUTTON="yes"

# Chế độ Đào tạo: giao diện Ubuntu (GNOME) với LibreOffice, Microsoft 365, Google Drive, mở file từ USB.
# "yes" rồi chạy lại sudo ./install.sh (tải khoảng 1-2 GB lần đầu). Khi bật, nút ⇄ và Ctrl+Alt+M
# đổi vòng: Màn TV -> Ca & Kho việc -> Đào tạo. Tài khoản Đào tạo không mật khẩu, không quyền quản trị.
ENABLE_TRAINING="no"
TRAINING_USER="daotao"

# In phiếu, QR: thêm máy in bằng: sudo smilelog-tv printer add TÊN IP
# "yes": bấm In là in thẳng ra máy in mặc định, không hiện hộp chọn máy in.
KIOSK_PRINTING="no"

# --- Chế độ full ---
# Trang mở khi bật máy: Kho việc. Đổi thành .../orders nếu muốn mở Danh sách ca trước.
APP_URL="https://smilelog.vn/kho-viec"
# Các màn được phép, cách nhau bởi dấu cách. Tính cả trang con (/orders/123, /orders/new)
# và trang đăng nhập. Danh sách ca = /orders, Kho việc = /kho-viec.
APP_PATHS="/orders /kho-viec"
# Tên miền của Smilelog, cách nhau bởi dấu cách (khớp cả tên miền con).
# Để trống thì lấy tên miền của APP_URL.
APP_HOSTS=""

# --- Chế độ tv ---
# Trang mở khi bật máy. Kiểm tra lại tên miền Prod trước khi dùng.
TV_URL="https://smilelog.vn/production-tv"

# Đường dẫn được coi là "đúng màn". Trang khác (lỗi mạng, trang lạ) bị watchdog mở lại.
EXPECTED_PATH="/production-tv"

# URL chứa chuỗi này được coi là trang đăng nhập: watchdog báo động, không khởi động lại.
LOGIN_PATTERN="login"

# Cách kiosk vẽ màn hình (Màn TV, Ca & Kho việc). install.sh hỏi chọn mỗi lần chạy tay
# (Enter = giữ), hoặc: sudo ./install.sh --display x11|wayland
#   x11     (mặc định): RustDesk xem và điều khiển được màn hình kiosk từ xa.
#   wayland : cage, khoá chặt nhất, hình mượt; RustDesk không xem được màn hình kiosk.
DISPLAY_SERVER="x11"

# Độ phân giải xuất ra TV. 1080p giúp Pi chạy mát và mượt hơn 4K; ở 55" nhìn xa không thấy khác.
# Để trống để dùng độ phân giải mặc định của TV. Đổi xong cần khởi động lại máy.
RESOLUTION="1920x1080"

# Múi giờ của máy: giờ làm việc, màn chờ và giờ khởi động lại đều tính theo múi này.
TIMEZONE="Asia/Ho_Chi_Minh"

# Giờ làm việc. Mặc định để trống: Màn TV chiếu 24/7, mọi ngày, vì Lab làm việc suốt ngày đêm;
# TV chỉ tối khi có người tắt TV. Chỉ site muốn màn chờ (đồng hồ trôi trên nền đen, để TV không
# lưu ảnh và không lộ số liệu khi Lab vắng) ngoài giờ mới đặt cả WORK_START, WORK_END và WORK_DAYS.
# WORK_DAYS: 1 = thứ 2 ... 7 = chủ nhật. Ca qua đêm thì đặt WORK_START lớn hơn WORK_END.
# Ví dụ: WORK_START="07:00", WORK_END="19:30", WORK_DAYS="1,2,3,4,5,6".
WORK_START=""
WORK_END=""
WORK_DAYS="1,2,3,4,5,6"

# Chống lưu ảnh cho màn hình sáng 24/7 (chế độ tv và full). Để trống hoặc 0 để tắt từng mục.
# Đổi xong không cần chạy lại install.sh: trang đang mở tự đọc lại trong vòng 1 phút.
# Dời cả trang lên/sang trái tối đa BURNIN_SHIFT_PX điểm ảnh, mỗi BURNIN_SHIFT_MIN phút.
BURNIN_SHIFT_MIN="5"
BURNIN_SHIFT_PX="4"
# Màn chờ đồng hồ BURNIN_SAVER_SEC giây, mỗi BURNIN_SAVER_EVERY_MIN phút (tối thiểu 5). Không tải lại trang.
# Có người bấm, chạm, gõ phím trong 2 phút qua thì hoãn; chạm vào màn chờ là tắt ngay.
BURNIN_SAVER_EVERY_MIN="60"
BURNIN_SAVER_SEC="60"
# Làm tối ban đêm từ DIM_START tới DIM_END (qua đêm được), độ tối DIM_LEVEL (0.05 đến 0.8).
# Trang vẫn đọc và bấm được. Để trống DIM_START để tắt.
DIM_START="22:00"
DIM_END="05:00"
DIM_LEVEL="0.3"

# Hẹn giờ bật/tắt hẳn TV qua HDMI-CEC (Samsung gọi là Anynet+). Chỉ chạy trên Raspberry Pi.
# Mặc định để trống: không điều khiển bật/tắt TV; Màn TV chiếu 24/7.
SCREEN_ON=""
SCREEN_OFF=""
SCREEN_DAYS="Mon..Sat"

# Khởi động lại máy mỗi ngày để dọn bộ nhớ. Mặc định 19:00 (giờ Bruce chọn) vì Lab làm việc 24/7:
# màn hình tối khoảng 1 phút, ca đêm vẫn có Màn TV. Để trống để tắt.
REBOOT_AT="19:00"

# Vào máy từ xa qua Tailscale (SSH, xem màn hình kiosk). install.sh tự cài và bật tự cập nhật.
# Đăng nhập tự động: đặt khoá đăng nhập (Tailscale admin -> Settings -> Keys -> Generate auth key)
# vào /etc/smilelog-tv.tailscale-key, quyền 600. Không có khoá thì chạy: sudo smilelog-tv remote up
# rồi mở đường link hiện ra. KHÔNG ghi khoá vào file cấu hình này (ai trên máy cũng đọc được).
ENABLE_TAILSCALE="yes"
TAILSCALE_HOSTNAME=""

# RustDesk: xem và điều khiển màn hình từ xa. install.sh tự cài, đặt mật khẩu cố định (lưu ở
# /etc/smilelog-tv.rustdesk-password, chỉ root đọc) và nâng cấp mỗi đêm.
# Xem ID và mật khẩu: sudo smilelog-tv rustdesk
# Lưu ý: RustDesk chỉ điều khiển được ở chế độ Đào tạo (chạy X11). Màn TV, Ca & Kho việc là kiosk
# Wayland: xem màn hình qua Tailscale + chrome://inspect (README), hoặc đổi tạm sang Đào tạo.
# RUSTDESK_VERSION trống = bản mới nhất; ghi số (ví dụ "1.5.1") để giữ cố định.
ENABLE_RUSTDESK="yes"
RUSTDESK_VERSION=""

# Cập nhật từ xa: mỗi ngày máy lấy bản mới nhất từ GitHub và tự cài lại; màn hình tối 10-30 giây khi có bản mới,
# nên đặt trước giờ REBOOT_AT để gộp vào lúc khởi động lại.
# Cập nhật ngay: sudo smilelog-tv update. Để trống AUTO_UPDATE_AT để tắt tự cập nhật.
UPDATE_REPO="https://github.com/Brucedentalstudio/Bruce-tvkiosk.git"
UPDATE_BRANCH="main"
AUTO_UPDATE_AT="18:30"

# Kiểm tra bản mới mỗi AUTO_UPDATE_CHECK_MIN phút: nhánh UPDATE_BRANCH có commit mới thì cài ngay, không
# đợi lượt AUTO_UPDATE_AT (màn hình tối 10-30 giây khi kiosk mở lại). Không có gì mới thì không làm gì.
# Để trống để tắt.
AUTO_UPDATE_CHECK_MIN="10"

# Webhook nhận báo động (POST JSON {"text": "..."}), ví dụ Make, n8n, Slack.
# Để trống thì chỉ ghi log (xem bằng: smilelog-tv status).
ALERT_WEBHOOK=""
